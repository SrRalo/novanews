---
import BlogCard from '@/components/BlogCard.astro'
import MostVisitedCard from '@/components/MostVisitedCard.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import { buttonVariants } from '@/components/ui/button'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getRecentPosts, getMostVisitedPost } from '@/lib/data-utils'

const blog = await getRecentPosts(SITE.featuredPostCount)
const mostVisitedPost = await getMostVisitedPost()

// Schema.org data for homepage
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": SITE.title,
  "description": SITE.description,
  "url": SITE.href,
  "author": {
    "@type": "Person",
    "name": SITE.author
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${SITE.href}/blog?search={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
}
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Home" />
  
  <!-- Schema.org JSON-LD para la homepage -->
  <script type="application/ld+json" slot="head">
    {JSON.stringify(websiteSchema)}
  </script>
  
  <section>
    <div class="rounded-lg border">
      <div class="flex flex-col space-y-1.5 p-6">
        <h1 class="text-3xl leading-none font-medium">SrR</h1>
        <p class="text-muted-foreground text-sm">
          2025 &bull; <span class="font-medium">Developer</span>
        </p>
      </div>
      <div class="p-6 pt-0">
        <p class="text-muted-foreground mb-2 text-sm">
          Bienvenido a nuestro espacio digital donde diariamente exploramos las últimas tendencias en innovación tecnológica. Aquí encontrarás análisis profundos sobre inteligencia artificial, blockchain, computación cuántica y las tecnologías emergentes que están transformando nuestro mundo. Nos mantenemos a la vanguardia para traerte contenido relevante y actualizado sobre el futuro digital.
        </p>
        <p class="text-muted-foreground text-sm">
          Únete a nuestra comunidad de entusiastas tecnológicos y mantente informado sobre las revoluciones digitales que están moldeando el mañana. Para más información, visita nuestro <Link
            href="/blog"
            class="text-foreground"
            underline>blog</Link
          > donde publicamos contenido fresco diariamente.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Sección del Post Más Visitado -->
  {mostVisitedPost && (
    <section class="flex flex-col gap-y-4">
      <h2 class="text-2xl font-medium flex items-center gap-2">
        <span class="text-orange-500">🔥</span>
        Más Visitado
      </h2>
      <MostVisitedCard entry={mostVisitedPost} />
    </section>
  )}
  
  <section class="flex flex-col gap-y-4">
    <h2 class="text-2xl font-medium">Latest posts</h2>
    <ul class="flex flex-col gap-y-4">
      {
        blog.map((post) => (
          <li>
            <BlogCard entry={post} />
          </li>
        ))
      }
    </ul>
    <div class="flex justify-center">
      <Link
        href="/blog"
        class={buttonVariants({ variant: 'ghost' }) + ' group'}
      >
        See all posts <span
          class="ml-1.5 transition-transform group-hover:translate-x-1"
          >&rarr;</span
        >
      </Link>
    </div>
  </section>
</Layout>
