---
import { SITE } from '@/consts'
import { isSubpost } from '@/lib/data-utils'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props

const title = post.data.title || SITE.title
const description = post.data.description || SITE.description
const defaultImage = new URL('/static/1200x630.png', Astro.site)

// Mapear posts a imágenes estáticas específicas
const postImageMap: Record<string, string> = {
  'blockchain-2025-casos-de-usos-reales-aparte-de-las-criptomonedas': '/og-images/blockchain-banner.jpg',
  'ia-generativa-guia-completa-de-tecnologias-y-aplicaciones-practicas-en-2025': '/og-images/ia-generativa-banner.jpg',
  'top-herramientas-gratuitas-de-inteligencia-artificial': '/og-images/herramientas-ia-banner.jpg'
}

// Construir URL correcta para la imagen del post con cache busting
let postImageUrl = defaultImage.toString()
const postSlug = post.id.replace('/index', '')
const cacheBuster = Date.now()

// Prioridad: 1) Imagen en frontmatter, 2) Imagen en mapeo estático, 3) Imagen por defecto
if (post.data.image?.src) {
  // Si el post tiene una imagen definida en el frontmatter, usarla
  postImageUrl = `${SITE.href.replace(/\/$/, '')}${post.data.image.src}?v=${cacheBuster}`
} else if (postImageMap[postSlug]) {
  // Si no, usar la imagen del mapeo estático
  postImageUrl = `${SITE.href.replace(/\/$/, '')}${postImageMap[postSlug]}?v=${cacheBuster}`
}
// Si no hay ninguna de las anteriores, usar la imagen por defecto (ya está asignada)

const author =
  post.data.authors && post.data.authors.length > 0
    ? post.data.authors.join(', ')
    : SITE.author
---

<title>{`${title} | ${SITE.title}`}</title>
<meta name="title" content={`${title} | ${SITE.title}`} />
<meta name="description" content={description} />
<link rel="canonical" href={Astro.url} />

{isSubpost(post.id) && <meta name="robots" content="noindex" />}

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<!-- Open Graph Image con cache busting -->
<meta
  property="og:image"
  content={postImageUrl}
/>
<meta property="og:image:alt" content={title} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:secure_url" content={postImageUrl} />
<meta property="og:type" content="article" />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:url" content={Astro.url} />
<meta property="og:author" content={author} />

<!-- Meta tags específicos para WhatsApp -->
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />

<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta
  property="twitter:image"
  content={postImageUrl}
/>
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:creator" content={author} />

{
  post?.data.tags &&
    post.data.tags.map((tag: string) => {
      return <meta property="article:tag" content={tag} />
    })
}

<!-- Schema.org JSON-LD para artículos -->
<script type="application/ld+json">
{
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "image": postImageUrl,
    "author": {
      "@type": "Person",
      "name": author
    },
    "publisher": {
      "@type": "Organization",
      "name": SITE.title,
      "url": SITE.href
    },
    "datePublished": post.data.date.toISOString(),
    "dateModified": post.data.date.toISOString(),
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": Astro.url.toString()
    },
    "keywords": post.data.tags?.join(", ") || ""
  })
}
</script>
