---
import Link from './Link.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
const { data, id } = entry
const slug = id
---

<div class="group relative rounded-lg border bg-gradient-to-r from-orange-50 to-red-50 dark:from-orange-950/20 dark:to-red-950/20 p-6 hover:shadow-md transition-all duration-200">
  <!-- Badge de "Más Visitado" -->
  <div class="absolute -top-2 -right-2">
    <span class="inline-flex items-center rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-medium text-red-800 dark:bg-red-900 dark:text-red-200 shadow-sm">
      🔥 Más Visitado
    </span>
  </div>
  
  <!-- Imagen del post si existe -->
  {data.image && (
    <div class="mb-4 overflow-hidden rounded-md">
      <img 
        src={data.image.src} 
        alt={data.title}
        class="h-48 w-full object-cover transition-transform group-hover:scale-105"
      />
    </div>
  )}
  
  <!-- Contenido -->
  <div class="space-y-3">
    <div class="flex items-center gap-2 text-sm text-muted-foreground">
      <time datetime={data.date.toISOString()}>
        {data.date.toLocaleDateString('es-ES', {
          year: 'numeric',
          month: 'long', 
          day: 'numeric'
        })}
      </time>
      {data.tags && data.tags.slice(0, 2).map((tag) => (
        <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-1 text-xs font-medium text-gray-800 dark:bg-gray-800 dark:text-gray-200">
          {tag}
        </span>
      ))}
    </div>
    
    <div>
      <h3 class="font-semibold text-lg leading-tight group-hover:text-primary transition-colors">
        <Link href={`/blog/${slug}`} class="stretched-link">
          {data.title}
        </Link>
      </h3>
      
      {data.description && (
        <p class="mt-2 text-sm text-muted-foreground line-clamp-2">
          {data.description}
        </p>
      )}
    </div>
    
    <!-- Indicador de popularidad -->
    <div class="flex items-center gap-2 text-xs text-muted-foreground">
      <div class="flex items-center gap-1">
        <span class="text-orange-500">👁️</span>
        <span>Trending</span>
      </div>
      <div class="flex items-center gap-1">
        <span class="text-green-500">📈</span>
        <span>Popular</span>
      </div>
    </div>
  </div>
</div>

<style>
  .stretched-link::after {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    content: "";
  }
  
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
